dev_test=false
if test "$1" = "dev-test"
then
    dev_test=true
    shift
    set -xeu
else
    set -eu
fi

APP_ROOT="`pwd`"
export APP_ROOT

. .3bs/*essential.sh

prohibit_git=false
for arg in "$@"
do
    if test "$arg" = "--prohibit-git"
    then
        prohibit_git=true
        break
    fi
done


(
    cd `dirname $0` # Typically .3bs

    . *install.util.sh

    _DisplayTrace 'Installing 3bs into local directory...'

    git rev-parse HEAD > Asset/current.ver

    cp -fa Parent/. ..
    rm -fr Parent
)

rm -fr LICENSE README.md devutil .git

if test $dev_test = true
then
    : "Remove this install script: typically .3bs/install"
    rm "$0"
fi

: "Create a git repository if git is available."
if command -v git &> /dev/null && test "$prohibit_git" = false
then
    _DisplayTrace "Initializing git repository..."
    git init . --quiet
else
    _DisplayInfo "Git not found, or has been prohibited; skipping git repository initialization."
fi

_DisplayTrace '3bs installed.'