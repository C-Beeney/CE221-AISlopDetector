. .3bs/*essential.sh

here="`readlink -f $(dirname ${BASH_SOURCE[0]})`"
this="`basename ${BASH_SOURCE[0]} .util.sh`"

set -e

if test -n "$1"
then
    repopath="$1"
else
    repopath="."
fi

hash="`cat .3bs/Asset/current.ver`"

: "children"
git -C "$repopath" rev-list --all --ancestry-path $hash..HEAD | sort > temp1.dat

: "significant"
git -C "$repopath" show-ref --hash | sort > temp2.dat

update_paths="`comm -12 temp1.dat temp2.dat`"

annotated_paths="`echo $update_paths | git name-rev --annotate-stdin | nl -w2 -s' -> '`"

if test -z "$update_paths"
then
    _DisplayInfo "No updates available" | tee /dev/tty > /dev/null
    exit 0
fi

echo "$annotated_paths" | sed 's/(/\| /g;s|/[^| ]*/|/|g;s|[^| ]*/||g;s/)//g' 1>&2

_DisplayInfo "Which branch do you wish to update to: " --no-newline 1>&2
read -r answer
branch=${update_paths[answer-1]}

_DisplayTrace "selecting branch: $branch" 1>&2   # log to stderr so it doesn't go to caller

echo "$branch"