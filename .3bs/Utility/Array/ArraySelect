set -eu

test $# -gt 1 || exit 1

n="$1"

while test $n -gt 0
do
    test $# -gt 0 || exit 1
    shift
    n="`expr \"$n\" - 1`"
done

test $# -gt 0 || exit 1
echo "$1"


