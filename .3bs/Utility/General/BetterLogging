here="`readlink -f $(dirname ${BASH_SOURCE[0]})`"
this="`basename ${BASH_SOURCE[0]} .util.sh`"

# Load utility functions
. "$here/.$this/"*

# 192 136 180
_DisplayInfo() {
    _SetColour custom 100 190 180
        printf "I: %s%s" "${1-Null}"
        test "${2-}" != "--no-newline" && printf "\n"
    _SetColour reset
}
_DisplayTrace() {
    _SetColour custom 60 60 60
        printf "T: %s%s" "${1-Null}"
        test "${2-}" != "--no-newline" && printf "\n"
    _SetColour reset
}
_DisplayWarning() {
    _SetColour custom 200 130 15
        printf "W: %s%s" "${1-Null}"
        test "${2-}" != "--no-newline" && printf "\n"
    _SetColour reset
}
_DisplayError() {
    _SetColour red
        printf "E: %s%s" "${1-Null}"
        test "${2-}" != "--no-newline" && printf "\n"
    _SetColour reset
}