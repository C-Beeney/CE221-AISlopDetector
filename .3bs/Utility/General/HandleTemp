_CreateTempIfNotExists() {
    current_dir="`readlink -f \"\`dirname \\\"$0\\\"\`\"`"
    temp_dir="$current_dir/.3bs/Temp"/"$1"

    if test ! -d "$temp_dir" && test "${2-}" != "phony"
    then
        mkdir -p "$temp_dir"
    fi

    echo "$temp_dir"
}

_RemoveTemp() {
    temp_dir_unfiltered="`dirname $0`"/.3bs/Temp/$1
    temp_dir="`readlink -f $temp_dir_unfiltered`"
    rm -rf "$temp_dir"
}